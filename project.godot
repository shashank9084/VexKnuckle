; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=1

[application]

config/name="VexKnuckle"
config/tags=PackedStringArray("pending....")
run/main_scene="uid://cvp7jdgdbylpj"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=true
config/icon="uid://cvg1u7f0eka2m"

[autoload]

NetworkManeger="*uid://dgi2u40fx7bnb"
DebugMenu="uid://c4fuh0bx4424w"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=3
window/frame_pacing/android/enable_frame_pacing=false
window/frame_pacing/android/swappy_mode=0
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/dpi/allow_hidpi=false

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick_DX/plugin.cfg")

